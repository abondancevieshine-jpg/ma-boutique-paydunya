import express from "express";
import dotenv from "dotenv";

dotenv.config();

const app = express();
app.use(express.json());
app.use(express.urlencoded({ extended: true }));

const PORT = process.env.PORT || 3000;
const BASE_URL = process.env.PUBLIC_BASE_URL?.replace(/\/$/, "");

app.get("/api/health", (_req, res) => {
  res.json({
    ok: true,
    mode: "test",
    payment_methods: ["MTN MoMo", "Moov Money"]
  });
});

app.post("/api/checkout", async (req, res) => {
  try {
    const amount = Number(req.body.amount);

    if (!Number.isFinite(amount) || amount <= 0) {
      return res.status(400).json({ error: "Montant invalide" });
    }

    if (!BASE_URL) {
      return res.status(500).json({
        error: "PUBLIC_BASE_URL non configurée"
      });
    }

    const payload = {
      invoice: {
        channels: [
          "mtn-benin",
          "moov-benin"
        ],
        total_amount: Math.round(amount),
        description: String(
          req.body.description || "Commande ASCENSION PLUS"
        )
      },

      store: {
        name: "ASCENSION PLUS",
        website_url: "https://canva.link/84fvz7htdef7x2l"
      },

      actions: {
        cancel_url: `${BASE_URL}/cancel`,
        return_url: `${BASE_URL}/success`,
        callback_url: `${BASE_URL}/api/callback`
      }
    };

    const response = await fetch(
      "https://app.paydunya.com/sandbox-api/v1/checkout-invoice/create",
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "PAYDUNYA-MASTER-KEY":
            process.env.PAYDUNYA_MASTER_KEY,
          "PAYDUNYA-PRIVATE-KEY":
            process.env.PAYDUNYA_PRIVATE_KEY,
          "PAYDUNYA-TOKEN":
            process.env.PAYDUNYA_TOKEN
        },
        body: JSON.stringify(payload)
      }
    );

    const data = await response.json();

    if (!response.ok || data.response_code !== "00") {
      return res.status(502).json({
        error: "PayDunya n'a pas créé la facture",
        paydunya: data
      });
    }

    res.json({
      ok: true,
      payment_url: data.response_text,
      token: data.token
    });

  } catch (error) {
    console.error(error);
    res.status(500).json({
      error: "Erreur serveur"
    });
  }
});

app.post("/api/callback", (req, res) => {
  console.log("Callback PayDunya reçu :", req.body);
  res.sendStatus(200);
});

app.get("/success", (_req, res) => {
  res.send("Paiement terminé. Merci pour votre commande.");
});

app.get("/cancel", (_req, res) => {
  res.send("Paiement annulé.");
});

app.listen(PORT, () => {
  console.log(
    `ASCENSION PLUS — serveur démarré sur le port ${PORT}`
  );
});
